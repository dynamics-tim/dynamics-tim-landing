---
import BaseLayout from '../layouts/BaseLayout.astro';
import EngagementQuiz from '../components/EngagementQuiz.astro';
import { to } from '../utils/url';
---

<BaseLayout
  title="Dynamics 365 Engagement-Check"
  description="Finde in drei Fragen heraus, welches Dynamics 365 Engagement-Modell zu deinem Team passt."
  breadcrumbs={[{ name: 'Engagement-Check', url: '/check/' }]}
>
  <section class="bg-surface-100 py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-10 max-w-3xl space-y-4">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Engagement-Check</p>
        <h1 class="section-title">Welcher Einstieg passt zu eurem Dynamics 365 Setup?</h1>
        <p class="text-lg text-slate-600">
          Beantworte drei Fragen und erhalte in unter 60 Sekunden eine konkrete Empfehlung.
        </p>
      </div>
    </div>
  </section>
  {/* The engagement models live on the home page, so result links point there */}
  <EngagementQuiz modelLinkBase={to('/')} />
</BaseLayout>
