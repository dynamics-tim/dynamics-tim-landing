---
import BaseLayout from '../layouts/BaseLayout.astro';
import HealthCheck from '../components/HealthCheck.astro';
import { healthCheckIntro } from '../data/home';
---

<BaseLayout
  title="Dynamics 365 Health-Check"
  description="Wie release-fähig ist euer Dynamics 365? Acht Fragen, sofortiger Score pro Bereich und die drei größten Hebel. Kostenlos und ohne Anmeldung."
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Health-Check', url: '/check/' },
  ]}
>
  <section class="ink-surface border-b border-white/10 pb-4 pt-16 sm:pt-24">
    <div class="mx-auto max-w-page px-5 sm:px-8">
      <p class="eyebrow text-lime-400">{healthCheckIntro.eyebrow}</p>
      <h1 class="display mt-5 max-w-4xl text-5xl text-paper sm:text-7xl">{healthCheckIntro.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-300">{healthCheckIntro.text}</p>
    </div>
  </section>
  <HealthCheck showIntro={false} />
</BaseLayout>
