---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HealthCheck from '../components/HealthCheck.astro';
import Story from '../components/home/Story.astro';
import Services from '../components/home/Services.astro';
import Results from '../components/home/Results.astro';
import Approach from '../components/home/Approach.astro';
import Recruiter from '../components/home/Recruiter.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';
import { engagementModels } from '../data/engagement-models';
import { faqs } from '../data/home';
import { to } from '../utils/url';
import { faqPageSchema, getPageUrls, serviceItemListSchema } from '../utils/structured-data';

const { siteUrl, personId } = getPageUrls(Astro.site, Astro.url);

const structuredData = [
  faqPageSchema(faqs),
  serviceItemListSchema(
    'Dynamics 365 & Power Platform Services',
    engagementModels.map((model) => ({
      name: model.title,
      description: model.description,
      url: new URL(to(`services#${model.id}`), siteUrl).toString(),
    })),
    personId
  ),
];
---

<BaseLayout
  title="Dynamics 365 Developer & Technical Consultant"
  description="Dein CRM verdient bessere Releases: Dynamics 365 Freelancer für saubere Plugins, automatisierte Releases, Azure-Integrationen und Monitoring. Jetzt kostenlosen Health-Check machen."
  breadcrumbs={[{ name: 'Startseite', url: '/' }]}
>
  <Hero />
  <Story />
  <HealthCheck />
  <Services />
  <Results />
  <Approach />
  <Recruiter />
  <Faq />
  <Contact />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
