---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EngagementQuiz from '../components/EngagementQuiz.astro';
import ProblemSolutionStrip from '../components/home/ProblemSolutionStrip.astro';
import WhyMe from '../components/home/WhyMe.astro';
import EngagementModels from '../components/home/EngagementModels.astro';
import References from '../components/home/References.astro';
import ApproachSteps from '../components/home/ApproachSteps.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import QuickAuditBanner from '../components/home/QuickAuditBanner.astro';
import { engagementModels } from '../data/engagement-models';
import { faqs } from '../data/home';
import { to } from '../utils/url';
import {
  faqPageSchema,
  getPageUrls,
  serviceItemListSchema,
} from '../utils/structured-data';

const { siteUrl, personId } = getPageUrls(Astro.site, Astro.url);

const structuredData = [
  faqPageSchema(faqs),
  serviceItemListSchema(
    'Dynamics 365 & Power Platform Services',
    engagementModels.map((model) => ({
      name: model.title,
      description: model.description,
      url: new URL(to(model.href), siteUrl).toString(),
    })),
    personId
  ),
];
---

<BaseLayout
  title="Dynamics 365 Developer & Technical Consultant"
  description="Dynamics 365 Freelancer für Service- & Sales-Prozesse: Power Platform Engineering, Azure Integrationen, DevOps & Enablement."
  breadcrumbs={[{ name: 'Startseite', url: '/' }]}
>
  <Hero />
  <ProblemSolutionStrip />
  <EngagementQuiz />
  <WhyMe />
  <EngagementModels />
  <References />
  <ApproachSteps />
  <Faq />
  <FinalCta />
  <QuickAuditBanner />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
