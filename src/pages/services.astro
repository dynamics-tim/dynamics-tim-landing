---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import { collaborationFormats, coreServices } from '../data/services';
import { site } from '../data/site';
import { getPageUrls, serviceItemListSchema } from '../utils/structured-data';

const { canonicalUrl, personId } = getPageUrls(Astro.site, Astro.url);

const serviceListSchema = serviceItemListSchema(
  'Dynamics 365 Leistungen & Consulting',
  coreServices.map((service) => ({
    name: service.title,
    description: service.description,
    url: new URL(`#${service.id ?? ''}`, canonicalUrl).toString(),
  })),
  personId
);
---

<BaseLayout
  title="Leistungen"
  description="Dynamics 365 Leistungen für Prozessdesign, Power Platform Engineering, Azure Integrationen und DevOps Enablement."
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Leistungen', url: '/services/' }
  ]}
>
  <section class="bg-surface-100 py-20 animate-on-scroll">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <h1 class="section-title">Leistungen im Überblick</h1>
      <p class="mt-6 text-lg text-slate-600">
        Ich verstärke dein Dynamics 365 Team als Professional/Senior Developer und Technical Consultant. Embedded im Team, mit Fokus auf Plugins, Scripts, CI/CD Optimization, Requirements Engineering, und Wissenstransfer.
      </p>
    </div>
  </section>

  <ServicesGrid
    heading="Kernkompetenzen"
    subheading="Strategie, Umsetzung und Betrieb – abgestimmt auf Dynamics 365 Sales & Service."
    items={coreServices}
  />

  <section class="bg-gradient-to-br from-brand-900 via-brand-800 to-accent-600 py-20 text-white animate-on-scroll">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="section-title text-white">Zusammenarbeitsmodelle</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {collaborationFormats.map((format) => (
          <div class="card card--on-dark text-left">
            <h3 class="text-xl font-semibold text-white">{format.title}</h3>
            <p class="mt-3 text-sm text-slate-200">{format.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20 animate-scale-up">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <h2 class="text-3xl font-semibold text-slate-900 sm:text-4xl">Lass uns sprechen</h2>
      <p class="mt-4 text-lg text-slate-600">
        Schicke mir deine Anforderungen oder buche direkt einen Termin. Ich melde mich innerhalb von 48 Stunden mit konkreten Vorschlägen zum Vorgehen.
      </p>
      <a
        href={site.contact.mailto}
        class="mt-8 inline-flex items-center rounded-2xl bg-brand-500 px-6 py-3 text-base font-semibold text-white shadow-soft transition hover:bg-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-200"
      >
        Kostenloses Erstgespräch vereinbaren
      </a>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(serviceListSchema)} />
</BaseLayout>
