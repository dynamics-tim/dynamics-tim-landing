---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import type { Breadcrumb } from '../utils/structured-data';
import { buildCsp, originOf } from '../utils/csp';
import { asset } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  url?: string;
  breadcrumbs?: Breadcrumb[];
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description,
  ogImage,
  url,
  breadcrumbs = [],
  showHeader = true,
  showFooter = true,
} = Astro.props as Props;

const env = import.meta.env;
const pushoverConfigured = Boolean(env.PUBLIC_PUSHOVER_TOKEN && env.PUBLIC_PUSHOVER_USER);
const goatcounterUrl = env.PUBLIC_GOATCOUNTER_URL;
const goatcounterOrigin = originOf(goatcounterUrl);

const csp = buildCsp({ pushover: pushoverConfigured, goatcounterOrigin });

/** Read by public/scripts/pushover-notifier.js */
const pushoverConfig = {
  pushoverToken: env.PUBLIC_PUSHOVER_TOKEN,
  pushoverUser: env.PUBLIC_PUSHOVER_USER,
  pushoverTitle: env.PUBLIC_PUSHOVER_TITLE,
  pushoverMessage: env.PUBLIC_PUSHOVER_MESSAGE,
};
const pushoverScript = asset('scripts/pushover-notifier.js');

/** Content stays visible without JS (all scroll animations start hidden). */
const noscriptCss =
  '.animate-on-scroll, .animate-scale-up { opacity: 1 !important; transform: none !important; animation: none !important; }';
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      url={url}
      breadcrumbs={breadcrumbs}
    />
    {
      goatcounterOrigin && (
        <script
          data-consent="analytics"
          data-target="head"
          data-goatcounter={goatcounterUrl}
          data-src="https://gc.zgo.at/count.js"
          data-attr-async
        ></script>
      )
    }
    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('favicon-16x16.png')} type="image/png" sizes="16x16" />
    <link rel="icon" href={asset('favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <!-- Keep in sync with the @font-face rules in styles/global.css -->
    <link rel="preload" href={asset('assets/fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset('assets/fonts/sora-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={asset('assets/css/consent.css')} />
    <noscript><style set:html={noscriptCss} /></noscript>
  </head>
  <body class="min-h-screen bg-slate-50">
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <script src={asset('assets/js/reveal.js')} defer></script>
    <script src={asset('assets/js/consent.js')} defer></script>
    {
      pushoverConfigured && (
        <script is:inline define:vars={{ pushoverConfig, pushoverScript }}>
          // Visit notification: load the notifier when the browser is idle
          window.__pushoverConfig = pushoverConfig;
          const loadNotifier = () => {
            const script = document.createElement('script');
            script.src = pushoverScript;
            script.defer = true;
            document.head.appendChild(script);
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadNotifier, { timeout: 1500 });
          } else if (document.readyState === 'complete') {
            setTimeout(loadNotifier, 200);
          } else {
            window.addEventListener('load', loadNotifier, { once: true });
          }
        </script>
      )
    }
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
