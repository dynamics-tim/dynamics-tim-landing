---
/**
 * 3-question quiz that recommends an engagement model.
 * Questions/copy: `data/engagement-quiz.ts` · Logic: `lib/engagement-quiz.ts`
 * · DOM wiring: `scripts/engagement-quiz.ts`
 */
import AvailabilityNote from './AvailabilityNote.astro';
import Icon from './Icon.astro';
import { quizQuestions } from '../data/engagement-quiz';
import { site } from '../data/site';

interface Props {
  /**
   * Prefix for "Mehr zum Modell" links. Leave empty on pages that render the
   * engagement models section (links scroll to it); otherwise pass the URL of
   * the page that does (e.g. the home page).
   */
  modelLinkBase?: string;
}

const { modelLinkBase = '' } = Astro.props as Props;

const optionClass =
  'quiz-btn rounded-xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-medium text-slate-700 transition hover:border-brand-400 hover:text-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-300/60';
const smallButtonClass =
  'rounded-lg border border-surface-300 text-slate-600 transition hover:border-brand-300 hover:text-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-300/60';
const resultBoxClass = 'rounded-xl border border-surface-200 bg-surface-50 p-4';
const resultBoxLabelClass = 'text-xs font-semibold uppercase tracking-wide text-slate-500';
---

<section
  class="bg-brand-900 py-20 text-white animate-on-scroll"
  aria-labelledby="engagement-quiz-title"
  data-engagement-quiz
  data-model-link-base={modelLinkBase}
>
  <div class="mx-auto max-w-6xl px-6">
    <div
      class="rounded-2xl border border-brand-700 bg-brand-900 p-8 shadow-soft"
      data-reveal
      data-reveal-delay="0"
      id="engagement-quiz"
    >
      <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
        <div class="max-w-2xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-100">
            Nicht sicher, was du brauchst?
          </p>
          <h2 id="engagement-quiz-title" class="text-2xl font-semibold text-white">
            Beantworte {quizQuestions.length} Fragen und erhalte eine passende Empfehlung.
          </h2>
          <p class="mt-2 text-sm text-white/70">
            Dauer: unter 60 Sekunden. Du kannst deine Antworten jederzeit anpassen.
          </p>
        </div>
        <div class="rounded-xl border border-white/15 bg-white/10 px-4 py-3 text-xs text-white/70">
          <p class="font-semibold uppercase tracking-wide text-signal-300">Schnellcheck</p>
          <p class="mt-1">Direkt umsetzbare Empfehlung statt allgemeiner Sales-Floskeln.</p>
        </div>
      </div>

      <div class="mt-7 space-y-5" id="quiz-container">
        <div class="rounded-2xl border border-surface-200 bg-white p-5">
          <div class="mb-3 flex items-center justify-between gap-3">
            <p id="quiz-step-label" class="text-sm font-semibold text-slate-800">Frage 1 von {quizQuestions.length}</p>
            <button
              id="quiz-reset-top"
              type="button"
              class={`hidden ${smallButtonClass} px-3 py-1.5 text-xs font-medium`}
            >
              Neu starten
            </button>
          </div>
          <div class="h-2 overflow-hidden rounded-full bg-surface-100">
            <div
              id="quiz-progress-bar"
              class="h-full w-0 rounded-full bg-gradient-to-r from-brand-500 to-accent-500 transition-all duration-300"
            >
            </div>
          </div>
        </div>

        <div class="space-y-5" id="quiz-steps">
          {
            quizQuestions.map((question, questionIndex) => (
              <div
                class={`quiz-step ${questionIndex > 0 ? 'hidden ' : ''}rounded-2xl border border-surface-200 bg-white p-6`}
                data-step={question.id}
              >
                <p class="text-base font-medium text-slate-800">
                  {questionIndex + 1}. {question.prompt}
                </p>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  {question.options.map((option, optionIndex) => (
                    <button
                      type="button"
                      class={
                        optionIndex === question.options.length - 1
                          ? `${optionClass} sm:col-span-2`
                          : optionClass
                      }
                      data-q={question.id}
                      data-v={option.value}
                      aria-pressed="false"
                    >
                      {option.label}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div id="quiz-result" class="hidden" aria-live="polite">
          <div
            class="quiz-result-card space-y-5 rounded-2xl border-2 border-brand-200 bg-white p-6 shadow-soft"
          >
            <div class="flex items-center gap-2">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-100 text-brand-600"
              >
                <Icon name="check" class="h-5 w-5" />
              </span>
              <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">
                Meine Empfehlung für dich
              </p>
            </div>
            <div>
              <span
                id="quiz-result-badge"
                class="mb-2 inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 ring-1 ring-brand-200/60"
              ></span>
              <h4 id="quiz-result-title" class="text-2xl font-semibold text-slate-900" tabindex="-1">
              </h4>
              <p id="quiz-result-tagline" class="mt-1 text-sm font-medium italic text-brand-600"></p>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div class={resultBoxClass}>
                <p class={resultBoxLabelClass}>Befund</p>
                <p id="quiz-result-finding" class="mt-2 text-sm text-slate-700"></p>
              </div>
              <div class={resultBoxClass}>
                <p class={resultBoxLabelClass}>Risiko</p>
                <p id="quiz-result-risk" class="mt-2 text-sm text-slate-700"></p>
              </div>
            </div>

            <div class={resultBoxClass}>
              <p class={resultBoxLabelClass}>Ableitung</p>
              <p id="quiz-result-derivation" class="mt-2 text-sm text-slate-700"></p>
            </div>

            <div class="rounded-xl border border-brand-100 bg-brand-50/60 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Beleg</p>
              <p
                id="quiz-result-proof-label"
                class="mt-2 text-[11px] font-medium uppercase tracking-[0.12em] text-slate-500"
              >
              </p>
              <blockquote
                id="quiz-result-proof"
                class="mt-2 border-l-2 border-brand-200 pl-3 text-sm italic text-slate-700"
              >
              </blockquote>
            </div>

            <div class={resultBoxClass}>
              <p class={resultBoxLabelClass}>Nächster Schritt</p>
              <p id="quiz-result-text" class="mt-2 text-base text-slate-600"></p>
            </div>

            <ul id="quiz-answer-summary" class="grid gap-2 text-xs text-slate-500 sm:grid-cols-3">
            </ul>
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a
                id="quiz-result-cal"
                href={site.contact.bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-glow inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-signal-400 via-signal-300 to-signal-500 px-6 py-3 text-sm font-semibold text-brand-900 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
              >
                30-Min Slot buchen →
              </a>
              <a
                id="quiz-result-link"
                href="#engagement-modelle"
                class="inline-flex items-center gap-1 text-sm font-semibold text-brand-500 hover:text-brand-400"
              >
                Mehr zum Modell &rarr;
              </a>
              <button id="quiz-edit" type="button" class={`${smallButtonClass} px-3 py-2 text-sm font-medium`}>
                Neu starten
              </button>
            </div>
            <AvailabilityNote class="flex items-center gap-1.5 text-xs text-slate-400" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initEngagementQuiz } from '../scripts/engagement-quiz';

  const root = document.querySelector<HTMLElement>('[data-engagement-quiz]');
  if (root) initEngagementQuiz(root);
</script>
