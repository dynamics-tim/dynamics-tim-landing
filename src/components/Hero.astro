---
import Icon from './Icon.astro';
import PitchVideo from './PitchVideo.astro';
import { clientLine, hero, heroStats } from '../data/home';
import { site } from '../data/site';
import { asset } from '../utils/url';
---

<section class="ink-surface relative overflow-hidden" aria-labelledby="hero-title">
  <div class="grid-lines pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-page px-5 pb-16 pt-12 sm:px-8 sm:pt-16 lg:pb-20 lg:pt-16">
    <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.6fr)] lg:gap-16">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="0">
          <span class="eyebrow text-ink-300">{hero.eyebrow}</span>
          <span class="inline-flex items-center gap-2 rounded-full border border-lime-500/30 bg-lime-500/10 px-3 py-1 text-xs font-semibold text-lime-300">
            <span class="status-dot" aria-hidden="true"></span>
            Verfügbar ab {site.availability.label}
          </span>
        </div>

        <h1 id="hero-title" class="display mt-6 text-[3.1rem] text-paper sm:text-7xl lg:text-[4.6rem] xl:text-[5.4rem]" data-reveal data-reveal-delay="60">
          {hero.headline.lead}
          <span class="block text-lime-400">{hero.headline.highlight}</span>
        </h1>

        <div class="mt-7 flex max-w-2xl items-start gap-4" data-reveal data-reveal-delay="120">
          <img
            src={asset('images/tim-portrait.jpg')}
            alt=""
            width="56"
            height="56"
            class="mt-1 hidden h-14 w-14 shrink-0 rounded-full object-cover ring-2 ring-lime-500/60 sm:block"
            loading="eager"
            decoding="async"
          />
          <p class="text-lg leading-relaxed text-ink-200 sm:text-xl">{hero.intro}</p>
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal data-reveal-delay="180">
          <a href="#health-check" class="btn btn-primary !min-h-[3.5rem] !px-7 !text-base" data-cta="hero-healthcheck">
            {hero.primaryCta}
            <Icon name="arrow-right" class="btn-arrow h-5 w-5" />
          </a>
          <a
            href={site.contact.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost-dark !min-h-[3.5rem] !px-7 !text-base"
            data-cta="hero-booking"
          >
            <Icon name="calendar" class="h-5 w-5" />
            {hero.secondaryCta}
          </a>
        </div>
        <p class="mt-3 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-ink-400" data-reveal data-reveal-delay="200">
          {hero.primaryNote}
        </p>
        <a href="#recruiter" class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink-300 no-underline hover:text-lime-400" data-reveal data-reveal-delay="220">
          {hero.recruiterLink}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mx-auto w-full max-w-[22rem] lg:max-w-none" data-reveal data-reveal-delay="160">
        <PitchVideo />
      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-8">
      <dl class="grid grid-cols-2 gap-y-8 sm:grid-cols-4">
        {
          heroStats.map((stat) => (
            <div class="flex flex-col sm:border-l sm:border-white/10 sm:pl-6 sm:first:border-l-0 sm:first:pl-0">
              <dt class="eyebrow order-2 mt-2 text-ink-400">{stat.label}</dt>
              <dd class="display order-1 text-4xl text-paper sm:text-5xl" data-counter>{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-400">
        <span class="eyebrow">{clientLine.label}</span>
        {clientLine.names.map((name) => <span class="font-semibold text-ink-200">{name}</span>)}
      </p>
    </div>
  </div>
</section>
