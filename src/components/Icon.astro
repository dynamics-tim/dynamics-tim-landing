---
/**
 * Inline SVG icon set. Icons are decorative by default (`aria-hidden`);
 * pass `label` to expose an accessible name instead.
 *
 * @example <Icon name="check" class="h-4 w-4" />
 */
type IconName =
  | 'check'
  | 'star'
  | 'code'
  | 'sparkles'
  | 'mail'
  | 'linkedin'
  | 'close'
  | 'arrow-right'
  | 'arrow-left'
  | 'play'
  | 'pause'
  | 'volume-on'
  | 'volume-off'
  | 'menu'
  | 'calendar'
  | 'shield'
  | 'plus';

interface IconDef {
  viewBox: string;
  /** `fill` icons use currentColor as fill, `stroke` icons as 2px outline */
  variant: 'fill' | 'stroke';
  path: string;
  evenOdd?: boolean;
}

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const icons: Record<IconName, IconDef> = {
  check: {
    viewBox: '0 0 20 20',
    variant: 'fill',
    evenOdd: true,
    path: 'M16.707 5.293a1 1 0 0 1 0 1.414l-7.25 7.25a1 1 0 0 1-1.414 0l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.793 2.793 6.543-6.543a1 1 0 0 1 1.414 0z',
  },
  star: {
    viewBox: '0 0 20 20',
    variant: 'fill',
    path: 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z',
  },
  code: {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  sparkles: {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  },
  mail: {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  linkedin: {
    viewBox: '0 0 24 24',
    variant: 'fill',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  close: {
    viewBox: '0 0 20 20',
    variant: 'fill',
    path: 'M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z',
  },
  'arrow-right': {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M5 12h14m-6-6 6 6-6 6',
  },
  'arrow-left': {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M19 12H5m6 6-6-6 6-6',
  },
  play: {
    viewBox: '0 0 24 24',
    variant: 'fill',
    path: 'M8 5.14v13.72a1 1 0 0 0 1.52.85l11.1-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z',
  },
  pause: {
    viewBox: '0 0 24 24',
    variant: 'fill',
    path: 'M7 4h3.5v16H7zM13.5 4H17v16h-3.5z',
  },
  'volume-on': {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M11 5 6 9H3v6h3l5 4V5zm4.5 3.5a5 5 0 0 1 0 7m2.8-9.8a9 9 0 0 1 0 12.6',
  },
  'volume-off': {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M11 5 6 9H3v6h3l5 4V5zm11 4-6 6m0-6 6 6',
  },
  menu: {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M4 7h16M4 12h16M4 17h10',
  },
  calendar: {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M8 3v3m8-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
  },
  shield: {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3zm-3 9 2 2 4-4',
  },
  plus: {
    viewBox: '0 0 24 24',
    variant: 'stroke',
    path: 'M12 5v14M5 12h14',
  },
};

const { name, class: className, label } = Astro.props as Props;
const icon = icons[name];
const isStroke = icon.variant === 'stroke';
---

<svg
  viewBox={icon.viewBox}
  fill={isStroke ? 'none' : 'currentColor'}
  stroke={isStroke ? 'currentColor' : undefined}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
>
  {
    isStroke ? (
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon.path} />
    ) : icon.evenOdd ? (
      <path fill-rule="evenodd" clip-rule="evenodd" d={icon.path} />
    ) : (
      <path d={icon.path} />
    )
  }
</svg>
