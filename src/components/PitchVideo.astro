---
/**
 * 15-second pitch video (4:5) in a frame styled like the video's own timecode overlay.
 *
 * Playback rules (scripts/pitch-video.ts):
 *  - muted autoplay only while ≥ 40 % visible
 *  - never autoplays with prefers-reduced-motion or Save-Data → poster + play button
 *  - once the visitor pauses, it stays paused
 */
import Icon from './Icon.astro';
import { pitchTranscript } from '../data/home';
import { asset } from '../utils/url';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<figure class={`pitch-video relative ${className}`} data-pitch-video>
  <div class="relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-ink-900 text-lime-400 shadow-[0_40px_120px_-40px_rgba(185,236,46,0.35)]">
    <video
      class="block aspect-[4/5] w-full object-cover"
      src={asset('media/pitch.mp4')}
      poster={asset('media/pitch-poster.jpg')}
      width="720"
      height="900"
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="Pitch-Video: Tim Friedrich in 15 Sekunden"
      aria-describedby="pitch-transcript"
      data-video
    ></video>

    <button
      type="button"
      class="absolute inset-0 grid place-items-center bg-ink-950/30 text-paper transition-opacity duration-300 data-[hidden=true]:pointer-events-none data-[hidden=true]:opacity-0"
      data-play-overlay
      data-hidden="true"
      tabindex="-1"
      aria-hidden="true"
      aria-label="Video abspielen"
    >
      <span class="grid h-16 w-16 place-items-center rounded-full bg-lime-500 text-ink-950 shadow-lg">
        <Icon name="play" class="ml-1 h-6 w-6" />
      </span>
    </button>

    <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-gradient-to-t from-ink-950/80 to-transparent px-3 pb-3 pt-10">
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-ink-950/60 text-paper backdrop-blur hover:border-lime-400 hover:text-lime-400"
        aria-label="Video pausieren"
        data-toggle-play
      >
        <span data-icon-pause><Icon name="pause" class="h-4 w-4" /></span>
        <span data-icon-play class="hidden"><Icon name="play" class="ml-0.5 h-4 w-4" /></span>
      </button>
      <button
        type="button"
        class="flex h-10 items-center gap-2 rounded-full border border-white/20 bg-ink-950/60 px-4 text-xs font-semibold text-paper backdrop-blur hover:border-lime-400 hover:text-lime-400"
        aria-pressed="false"
        data-toggle-sound
      >
        <span data-sound-icon-off><Icon name="volume-off" class="h-4 w-4" /></span>
        <span data-sound-icon-on class="hidden"><Icon name="volume-on" class="h-4 w-4" /></span>
        <span data-sound-label>Ton an</span>
      </button>
    </div>
  </div>

  <figcaption class="mt-3">
    <details class="group text-xs text-ink-400">
      <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 font-mono uppercase tracking-[0.16em] hover:text-paper">
        <Icon name="plus" class="h-3 w-3 transition-transform group-open:rotate-45" />
        Transkript
      </summary>
      <ol id="pitch-transcript" class="mt-3 space-y-1.5 text-sm leading-relaxed text-ink-300">
        {pitchTranscript.map((line) => <li>{line}</li>)}
      </ol>
    </details>
  </figcaption>
</figure>

<script>
  import '../scripts/pitch-video';
</script>
