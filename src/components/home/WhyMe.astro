---
import { notDoing, valueBullets } from '../../data/home';
---

<section class="bg-surface-100 py-20 animate-on-scroll">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="section-title" data-reveal data-reveal-delay="0">Warum Tim?</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3" data-reveal data-reveal-delay="80">
      {
        valueBullets.map((bullet, index) => (
          <div class="card" data-reveal data-reveal-delay={`${index * 80 + 160}`}>
            <h3 class="text-xl font-semibold text-slate-900">{bullet.title}</h3>
            <p class="mt-3 text-base text-slate-600">{bullet.description}</p>
          </div>
        ))
      }
    </div>
    <div
      class="mt-12 rounded-2xl border border-red-100 bg-red-50/40 p-6 md:p-8"
      data-reveal
      data-reveal-delay="400"
    >
      <h3 class="text-lg font-semibold text-slate-900 mb-4">
        Was ich <span class="text-red-600">NICHT</span> mache
      </h3>
      <div class="grid gap-4 md:grid-cols-3">
        {
          notDoing.map((entry) => (
            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-500 text-sm font-bold">
                ✗
              </span>
              <p class="text-sm text-slate-600">
                <strong class="text-slate-800">{entry.title}</strong> {entry.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
