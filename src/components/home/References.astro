---
import Icon from '../Icon.astro';
import { focusIndustries, stats, testimonials, type Testimonial } from '../../data/home';

const [leftTestimonial, rightTestimonial] = testimonials;
const columns: Array<{ testimonial?: Testimonial; delay: number }> = [
  { testimonial: leftTestimonial, delay: 200 },
  { delay: 280 },
  { testimonial: rightTestimonial, delay: 360 },
];
---

<section class="bg-white py-20 animate-on-scroll" id="referenzen">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="section-title" data-reveal data-reveal-delay="0">Stimmen aus der Praxis</h2>
    <p class="mt-4 max-w-3xl text-lg text-slate-600" data-reveal data-reveal-delay="80">
      Entscheidungen werden leichter, wenn andere den ersten Schritt schon gemacht haben.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3" data-reveal data-reveal-delay="160">
      {
        columns.map(({ testimonial, delay }) =>
          testimonial ? (
            <div class="card flex flex-col gap-4 bg-white/90" data-reveal data-reveal-delay={`${delay}`}>
              <div class="text-3xl text-brand-300 font-serif leading-none">"</div>
              <p class="text-base text-slate-700 flex-1">{testimonial.quote}</p>
              <div class="border-t border-surface-100 pt-3">
                <p class="text-sm font-semibold text-slate-900">{testimonial.author}</p>
                <p class="text-xs text-slate-500 mt-0.5">{testimonial.company}</p>
                {testimonial.verified && (
                  <p class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                    <Icon name="check" class="h-3 w-3 text-brand-400" />
                    Verifizierte Referenz
                  </p>
                )}
              </div>
            </div>
          ) : (
            <div
              class="card flex flex-col gap-4 bg-brand-900/95 text-white"
              data-reveal
              data-reveal-delay={`${delay}`}
            >
              <div class="grid grid-cols-3 gap-4 text-center">
                {stats.map((stat) => (
                  <div>
                    {/* keep the value on one line: the counter animation reads textContent */}
                    <p class="text-2xl font-bold text-signal-400" data-counter>{stat.value}</p>
                    <p class="text-xs text-white/70 mt-0.5">{stat.label}</p>
                  </div>
                ))}
              </div>
              <div class="border-t border-white/10 pt-4 space-y-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-white/50">
                  Fokus-Industrien
                </p>
                <div class="flex flex-wrap gap-2">
                  {focusIndustries.map((industry) => (
                    <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-xs text-white/80">
                      {industry}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          )
        )
      }
    </div>
  </div>
</section>
