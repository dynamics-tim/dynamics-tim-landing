---
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { engagementModels } from '../../data/engagement-models';
import { to } from '../../utils/url';

const summaryClass =
  'flex cursor-pointer items-center justify-between gap-2 p-4 text-xs font-semibold uppercase tracking-wide text-slate-500 hover:text-brand-600 transition-colors';
---

<section class="bg-surface-100 py-20 animate-on-scroll" id="engagement-modelle">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeader
      title="So arbeiten wir zusammen"
      subtitle="Drei Wege, wie ich dein Projekt voranbringen kann — je nachdem, wo du gerade stehst."
    />
    <div class="grid gap-6 lg:grid-cols-3">
      {
        engagementModels.map((model, index) => (
          <article
            id={model.id}
            class="card flex flex-col gap-5 border-surface-200 bg-white/90"
            data-reveal
            data-reveal-delay={`${index * 100 + 160}`}
          >
            <div>
              <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 ring-1 ring-brand-200/60">
                {model.badge}
              </span>
            </div>
            <div>
              <h3 class="text-2xl font-semibold text-slate-900">{model.title}</h3>
              <p class="mt-1 text-sm font-medium text-brand-600 italic">"{model.tagline}"</p>
            </div>
            <p class="text-base text-slate-600">{model.description}</p>
            <ul class="space-y-1.5">
              {model.features.map((feature) => (
                <li class="flex items-center gap-2 text-sm text-slate-700">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
                    <Icon name="check" class="h-3 w-3" />
                  </span>
                  {feature}
                </li>
              ))}
            </ul>
            {model.details.length > 0 && (
              <details class="group/det rounded-xl border border-surface-200 bg-surface-50 text-sm">
                <summary class={summaryClass}>
                  <span>Use Cases &amp; Tech Details</span>
                  <span
                    class="text-brand-400 transition-transform group-open/det:rotate-180"
                    aria-hidden="true"
                  >
                    ▾
                  </span>
                </summary>
                <ul class="px-4 pb-4 space-y-1.5">
                  {model.details.map((detail) => (
                    <li class="flex items-start gap-2 text-slate-600">
                      <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
                        <Icon name="check" class="h-2.5 w-2.5" />
                      </span>
                      {detail}
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <details class="group/spot rounded-xl border border-surface-200 bg-surface-50 text-sm">
              <summary class={summaryClass}>
                <span>Projekt-Spotlight: {model.caseStudy.industry}</span>
                <span
                  class="text-brand-400 transition-transform group-open/spot:rotate-180"
                  aria-hidden="true"
                >
                  ▾
                </span>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-slate-600 leading-relaxed">{model.caseStudy.text}</p>
              </div>
            </details>
            <a
              href={to(model.href)}
              class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-brand-500 transition hover:text-brand-400"
            >
              <span>{model.cta}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
