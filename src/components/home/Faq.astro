---
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { faqs } from '../../data/home';
---

<section class="border-t border-ink-950/10 bg-paper-50 py-24 sm:py-32" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-page gap-12 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-16">
    <SectionHeader id="faq-title" eyebrow="FAQ" title="Häufige Fragen" />
    <div class="divide-y divide-ink-950/10 border-y border-ink-950/10">
      {
        faqs.map((faq) => (
          <details class="group py-2" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg font-bold text-ink-950 marker:hidden">
              {faq.question}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-ink-950/15 transition-transform duration-300 group-open:rotate-45 motion-reduce:transition-none">
                <Icon name="plus" class="h-4 w-4" />
              </span>
            </summary>
            <p class="pb-5 pr-12 leading-relaxed text-ink-600" set:html={faq.answer} />
          </details>
        ))
      }
    </div>
  </div>
</section>
