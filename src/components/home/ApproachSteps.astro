---
import { approachSteps } from '../../data/home';
---

<section class="bg-surface-50 py-20 animate-on-scroll">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="section-title" data-reveal data-reveal-delay="0">So läuft eine Zusammenarbeit ab</h2>
    <p class="mt-4 max-w-3xl text-lg text-slate-600" data-reveal data-reveal-delay="80">
      Kein generisches Consulting-Framework. Ein erprobter Ablauf mit klarer Meinung — damit du
      weißt, was dich erwartet.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-reveal data-reveal-delay="160">
      {
        approachSteps.map((step, index) => (
          <div class="card relative overflow-hidden" data-reveal data-reveal-delay={`${index * 80 + 200}`}>
            <div
              class="absolute top-0 right-0 text-[5rem] font-black leading-none text-surface-200 select-none pointer-events-none"
              aria-hidden="true"
            >
              {step.phase}
            </div>
            <span class="inline-flex items-center rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 ring-1 ring-brand-200/60 mb-3">
              {step.duration}
            </span>
            <h3 class="text-xl font-semibold text-slate-900">{step.title}</h3>
            <p class="mt-1 text-sm font-medium text-brand-600 italic">"{step.tagline}"</p>
            <p class="mt-3 text-sm text-slate-600">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
