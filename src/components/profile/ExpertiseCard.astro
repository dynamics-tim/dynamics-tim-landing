---
/** Card with a gradient icon tile and a highlighted bullet list (profile page). */
import Icon from '../Icon.astro';
import type { ProfileListItem } from '../../data/profile';

type Tone = 'brand' | 'accent';

interface Props {
  title: string;
  items: ProfileListItem[];
  tone: Tone;
  icon: 'code' | 'sparkles';
  bulletIcon: 'check' | 'star';
  revealDelay: number;
}

const { title, items, tone, icon, bulletIcon, revealDelay } = Astro.props as Props;

/** Full class strings per tone (kept literal so Tailwind can detect them). */
const toneStyles: Record<Tone, { card: string; glow: string; tile: string; item: string; bullet: string }> =
  {
    brand: {
      card: 'border-brand-100 hover:shadow-[0_20px_60px_rgba(77,162,242,0.15)]',
      glow: 'from-brand-100 to-accent-100',
      tile: 'from-brand-500 to-brand-600',
      item: 'hover:bg-brand-50/50',
      bullet: 'bg-brand-100 text-brand-600',
    },
    accent: {
      card: 'border-accent-100 hover:shadow-[0_20px_60px_rgba(28,186,205,0.15)]',
      glow: 'from-accent-100 to-signal-100',
      tile: 'from-accent-500 to-accent-600',
      item: 'hover:bg-accent-50/50',
      bullet: 'bg-accent-100 text-accent-600',
    },
  };
const styles = toneStyles[tone];
---

<div
  class={`group relative overflow-hidden rounded-2xl border ${styles.card} bg-white p-6 shadow-soft transition-all duration-300 hover:-translate-y-1`}
  data-reveal
  data-reveal-delay={`${revealDelay}`}
>
  <div
    class={`absolute -right-8 -top-8 h-32 w-32 rounded-full bg-gradient-to-br ${styles.glow} opacity-0 blur-2xl transition-opacity duration-300 group-hover:opacity-100`}
  >
  </div>
  <div class="relative">
    <div class="mb-4 flex items-center gap-3">
      <div class={`flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${styles.tile} shadow-lg`}>
        <Icon name={icon} class="h-6 w-6 text-white" />
      </div>
      <h3 class="text-xl font-bold text-slate-900">{title}</h3>
    </div>
    <ul class="space-y-3 text-sm text-slate-600">
      {
        items.map((item) => (
          <li class={`flex items-start gap-3 rounded-lg p-2 transition ${styles.item}`}>
            <span class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${styles.bullet}`}>
              <Icon name={bulletIcon} class="h-3 w-3" />
            </span>
            <span>
              <strong class="text-slate-900">{item.title}:</strong> {item.text}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
